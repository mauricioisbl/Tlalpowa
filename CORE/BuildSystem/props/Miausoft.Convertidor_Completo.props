<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="Miausoft Target PreImport">
    <TargetName>Miausoft_Convertidor_Completo</TargetName>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)Miausoft.Output.Root.props" />
  <ItemDefinitionGroup Label="Miausoft Heavy Resources">
    <ClCompile>
      <AdditionalOptions>/bigobj /MP %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <AdditionalOptions>/LARGEADDRESSAWARE /STACK:536870912,8388608 /HEAP:1073741824,16777216 %(AdditionalOptions)</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>
</Project>
