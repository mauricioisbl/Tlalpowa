<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildThisFileDirectory)Miausoft.Core.props" />

  <PropertyGroup Label="Miausoft Output - EXE directo en base">
    <ErrorTextMissingTargetName>Miausoft Output Root requiere TargetName explícito antes de importar Miausoft.Output.Root.props.</ErrorTextMissingTargetName>
    <OutDir>$(MiausoftRootDir)</OutDir>
    <TargetExt Condition="'$(TargetExt)'==''">.exe</TargetExt>
    <TargetFileName>$(TargetName)$(TargetExt)</TargetFileName>
    <MiausoftFinalExe>$(MiausoftRootDir)$(TargetFileName)</MiausoftFinalExe>
    <TargetPath>$(MiausoftFinalExe)</TargetPath>
    <LocalDebuggerCommand>$(MiausoftFinalExe)</LocalDebuggerCommand>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <Link>
      <OutputFile>$(MiausoftFinalExe)</OutputFile>
      <ProgramDatabaseFile>$(MiausoftLinkRoot)$(MSBuildProjectName)\$(Platform)\$(Configuration)\$(TargetName).pdb</ProgramDatabaseFile>
    </Link>
  </ItemDefinitionGroup>

  <Target Name="MiausoftAssertRootExe" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(TargetName)'==''" Text="$(ErrorTextMissingTargetName)" />
  </Target>

  <Target Name="MiausoftAssertRootExeFinal" AfterTargets="Build">
    <Error Condition="!Exists('$(MiausoftFinalExe)')" Text="La compilación terminó pero no apareció el EXE final directamente en la base .Miausoft: $(MiausoftFinalExe)." />
    <Touch Files="$(MiausoftFinalExe)" AlwaysCreate="true" Condition="Exists('$(MiausoftFinalExe)')" />
  </Target>
</Project>
