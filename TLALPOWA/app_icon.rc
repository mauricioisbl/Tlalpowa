BEGIN

    BLOCK "StringFileInfo"
    BEGIN

        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Tlalpowa"

            VALUE "FileDescription", "Tlalpowa"

            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "Tlalpowa"

            VALUE "OriginalFilename", "Tlalpowa.exe"
            VALUE "ProductName", "Tlalpowa"

            VALUE "ProductVersion", "1.0.0"
        END
    END

    BLOCK "VarFileInfo"
    BEGIN

        VALUE "Translation", 0x409, 1200
    END
END
