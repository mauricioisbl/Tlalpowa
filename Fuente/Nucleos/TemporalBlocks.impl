    if (p == "nitrate" || p == "nitrato" || p == "nitrato en aerosol" || p == "no3a") return "no3a";
    if (p == "lead" || p == "plomo" || p == "plomo particulado" || p == "pb") return "pb";
    if (p == "cadmium" || p == "cadmio" || p == "cadmio particulado" || p == "cd") return "cd";
