        "SO2",
        "CO",
        "HCHO",
        "CH4",
        "UVAI",
        "cloud_fraction",
        "cloud_pressure",
        "cloud_top_temperature"
      ],
      "formatos_esperados": [
        "NetCDF-CF",
        "NetCDF-4",
        "CSV/JSON de catalogo"
      ]
    },
    {
      "id": "NASA_Aura_OMI",
      "satellite": "Aura",
      "sensor": "OMI",
      "variables_elementales": [
        "NO2",
        "O3",
        "UVAI",
        "cloud_fraction"
      ],
      "formatos_esperados": [
        "HDF-EOS5",
        "HDF-EOS",
        "JSON de catalogo"
      ]
    },
    {
