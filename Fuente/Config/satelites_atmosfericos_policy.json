{
  "schema": "tlalpowa.atmosfera.satelital.importacion.v3.elemental",
  "proposito": "Preparar importación satelital independiente de RAMA/SIMAT como datos directos por elemento IXIPTLAH, sin núcleo mensual mixto ni resúmenes persistentes.",
  "almacenamiento": {
    "crudo": "Datos externos/Satelitales/<producto>",
    "ixiptlah_elemental": "Datos/DATOS_METEOROLOGICOS__<ELEMENTO>.ixiptlah o Datos/DATOS_DE_CONTAMINANTES_ATMOSFERICOS__<ELEMENTO>.ixiptlah",
    "sin_subcarpetas_en_datos": true,
    "tipos_de_archivo_permitidos": [
      ".ixiptlah"
    ],
    "contrato": "Cada elemento del catálogo satelital o de superficie tiene su propio .ixiptlah. No se crean .ixsm por defecto, ni resúmenes diarios, horarios, mensuales o catálogos agregados."
  },
  "prohibiciones_estrictas": [
    "No crear resumen mensual ultraligero.",
    "No crear resumen diario.",
    "No crear resumen horario.",
    "No crear catálogos agregados de rango.",
    "No mezclar satélite y estación como derivado automático.",
    "No convertir AOD a PM sin modelo explícito externo y trazable."
  ],
  "independencia_de_linhaje": "Los productos satelitales se descargan e inventarian sin mezclarse con estaciones RAMA/SIMAT. La calibración contra estaciones debe ser una etapa analítica posterior, reproducible y con incertidumbre, no una sobrescritura ni un secundario automático.",
  "productos_iniciales": [
